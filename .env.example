# --- LLM (Groq, OpenAI-compatible API) ---
# Leave unset to run in mock mode (deterministic heuristic answers, no API
# key required) — useful for local dev, tests, and the evaluation script.
GROQ_API_KEY=
LLM_MODEL=llama3-8b-8192

# --- Embeddings / RAG ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=3
MAX_AGENT_RETRIES=2

# --- SQL storage ---
DATABASE_URL=sqlite:///./data/app.db
INDEX_DIR=./data/indexes

# --- MLflow ---
MLFLOW_TRACKING_URI=sqlite:///./data/mlflow.db
MLFLOW_EXPERIMENT_NAME=agentic-rag-qa
